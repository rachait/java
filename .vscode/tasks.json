{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto Sync: Start GitHub Watcher",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/auto-sync-github.ps1",
        "-RepoPath",
        "${workspaceFolder}"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
